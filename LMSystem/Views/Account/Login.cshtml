@model LoginViewModel
@{ ViewData["Title"]="Sign In"; }
<div class="auth-shell"><section class="auth-side"><span class="hub-logo large"><i></i><i></i><i></i></span><h1>Digital Library Hub</h1><p>Secure access for administrators, librarians and members.</p><div class="demo-logins"><strong>Demo accounts</strong><span>admin@example.com / Password123</span><span>librarian@example.com / Password123</span><span>member@example.com / Password123</span><span>Legacy: admin / 12345</span></div></section><section class="auth-card"><span class="eyebrow">WELCOME BACK</span><h2>Sign in to your account</h2><form asp-action="Login" method="post"><input type="hidden" asp-for="ReturnUrl"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="UsernameOrEmail"></label><input asp-for="UsernameOrEmail" class="form-control" autofocus/><span asp-validation-for="UsernameOrEmail"></span></div><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password"></span></div><div class="d-flex justify-content-between align-items-center mb-4"><label class="form-check"><input asp-for="RememberMe" class="form-check-input"/><span class="form-check-label">Remember me</span></label><a asp-action="ForgotPassword">Forgot password?</a></div><button class="btn btn-dark w-100">Sign In</button></form><p class="auth-foot">New member? <a asp-action="Register">Create an account</a></p></section></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
