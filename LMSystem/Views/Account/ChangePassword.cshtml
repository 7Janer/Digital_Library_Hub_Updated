@model ChangePasswordViewModel
@{ ViewData["Title"]="Change Password"; }
<div class="form-shell narrow"><div class="form-card"><div class="form-header"><i class="bi bi-shield-lock"></i><div><span>ACCOUNT SECURITY</span><h1>Change Password</h1></div></div><form asp-action="ChangePassword" method="post" class="form-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" class="form-control"/><span asp-validation-for="CurrentPassword"></span></div><div class="mb-3"><label asp-for="NewPassword"></label><input asp-for="NewPassword" class="form-control"/><span asp-validation-for="NewPassword"></span></div><div class="mb-3"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword"></span></div><div class="form-actions"><a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-dark">Change Password</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
