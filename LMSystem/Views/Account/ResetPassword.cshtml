@model ResetPasswordViewModel
@{ ViewData["Title"]="Reset Password"; }
<div class="form-shell narrow"><div class="form-card"><div class="form-header"><i class="bi bi-shield-lock"></i><div><span>ACCOUNT RECOVERY</span><h1>Reset Password</h1></div></div><form asp-action="ResetPassword" method="post" class="form-body"><input type="hidden" asp-for="Email"/><input type="hidden" asp-for="Token"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password"></span></div><div class="mb-3"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword"></span></div><div class="form-actions"><button class="btn btn-dark">Reset Password</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
