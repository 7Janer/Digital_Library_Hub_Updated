@model ForgotPasswordViewModel
@{ ViewData["Title"]="Forgot Password"; }
<div class="form-shell narrow"><div class="form-card"><div class="form-header"><i class="bi bi-key"></i><div><span>ACCOUNT RECOVERY</span><h1>Forgot Password</h1></div></div><form asp-action="ForgotPassword" method="post" class="form-body"><p class="text-muted">Enter your account email. In this local project, the reset form opens directly.</p><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email"></span></div><div class="form-actions"><a asp-action="Login" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-dark">Continue</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
