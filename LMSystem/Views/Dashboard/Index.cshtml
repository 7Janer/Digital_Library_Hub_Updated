@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<section class="dashboard-hero text-center">
    <h1>Digital Library Hub System</h1>
    <p>Your central platform for collection control and transaction tracking.</p>
</section>
<div class="hub-divider"></div>
<div class="row g-4 dashboard-cards">
    <div class="col-sm-6 col-xl-3"><article class="dashboard-card card-blue"><div class="dash-top"><div><span>Total Books</span><strong>@Model.TotalBooks</strong></div><i class="bi bi-book-half"></i></div><div class="dash-bottom"><b>BOOKS</b><a asp-controller="Books" asp-action="Index">View All Books</a></div></article></div>
    <div class="col-sm-6 col-xl-3"><article class="dashboard-card card-green"><div class="dash-top"><div><span>Total Students</span><strong>@Model.TotalStudents</strong></div><i class="bi bi-mortarboard-fill"></i></div><div class="dash-bottom"><b>STUDENTS</b>@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-controller="Student" asp-action="Index">View All Students</a>}else{<span class="dash-note">Directory protected</span>}</div></article></div>
    <div class="col-sm-6 col-xl-3"><article class="dashboard-card card-gold"><div class="dash-top"><div><span>Total Librarians</span><strong>@Model.TotalLibrarians</strong></div><i class="bi bi-key-fill"></i></div><div class="dash-bottom"><b>LIBRARIANS</b>@if(User.IsInRole("Administrator")){<a asp-controller="Librarian" asp-action="Index">View All Librarians</a>}else{<span class="dash-note">Admin access</span>}</div></article></div>
    <div class="col-sm-6 col-xl-3"><article class="dashboard-card card-red"><div class="dash-top"><div><span>Total Borrow Records</span><strong>@Model.TotalBorrowings</strong></div><i class="bi bi-clipboard2-check-fill"></i></div><div class="dash-bottom"><b>BORROW RECORDS</b>@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-controller="Borrow" asp-action="Index">View All Records</a>}else{<span class="dash-note">Staff access</span>}</div></article></div>
</div>
<div class="row g-4 mt-3">
    <div class="col-lg-8">
        <section class="content-panel h-100">
            <div class="panel-heading"><div><span>RECENT ACTIVITY</span><h2>Latest Borrow Transactions</h2></div><span class="status-pill">@Model.ActiveBorrowings active</span></div>
            @if (Model.RecentBorrowings.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-journal-check"></i><p>No borrowing activity yet.</p></div>
            }
            else
            {
                <div class="table-responsive"><table class="table hub-table mb-0"><thead><tr><th>Book</th><th>Borrower</th><th>Borrowed</th><th>Status</th></tr></thead><tbody>@foreach (var record in Model.RecentBorrowings){<tr><td>@record.Book?.Title</td><td>@record.BorrowerName</td><td>@record.BorrowDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@if(record.ReturnDate is null){<span class="badge text-bg-warning">Active</span>}else{<span class="badge text-bg-success">Returned</span>}</td></tr>}</tbody></table></div>
            }
        </section>
    </div>
    <div class="col-lg-4">
        <section class="content-panel h-100">
            <div class="panel-heading"><div><span>SYSTEM SNAPSHOT</span><h2>More Collections</h2></div></div>
            <a class="quick-link" asp-controller="Publications" asp-action="Index"><i class="bi bi-journals"></i><div><strong>@Model.TotalPublications Periodicals</strong><span>Magazines and newspapers</span></div><i class="bi bi-chevron-right"></i></a>
            @if(User.IsInRole("Administrator")){<a class="quick-link" asp-controller="UserAdmin" asp-action="Index"><i class="bi bi-person-gear"></i><div><strong>@Model.TotalUsers Identity Users</strong><span>Roles and member accounts</span></div><i class="bi bi-chevron-right"></i></a>}else{<a class="quick-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i><div><strong>My Account</strong><span>Profile and security settings</span></div><i class="bi bi-chevron-right"></i></a>}
        </section>
    </div>
</div>
