@model PublicationIndexViewModel
@{ ViewData["Title"] = Model.Type?.ToString() ?? "Periodicals"; var heading=Model.Type?.ToString() ?? "All Periodicals"; }
<div class="page-title-row"><div><span class="eyebrow">SERIAL COLLECTIONS</span><h1>@heading</h1><p>Search and manage magazines and newspaper issues.</p></div>@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-action="Create" asp-route-type="@Model.Type" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i>Add @((Model.Type?.ToString()) ?? "Publication")</a>}</div>
<section class="content-panel"><div class="list-toolbar"><form method="get" class="search-box"><input type="hidden" name="type" value="@Model.Type"/><i class="bi bi-search"></i><input name="searchTerm" value="@Model.SearchTerm" placeholder="Search title or publisher"/><button>Search</button>@if(!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-route-type="@Model.Type">Clear</a>}</form><div class="filter-tabs"><a class="@(Model.Type is null?"active":"")" asp-action="Index">All</a><a class="@(Model.Type==PublicationType.Newspaper?"active":"")" asp-action="Index" asp-route-type="Newspaper">Newspapers</a><a class="@(Model.Type==PublicationType.Magazine?"active":"")" asp-action="Index" asp-route-type="Magazine">Magazines</a></div></div><div class="table-responsive"><table class="table hub-table mb-0"><thead><tr><th>Title</th><th>Type</th><th>Publisher</th><th>Published Date</th><th>Availability</th><th>Actions</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-row">No publications found.</td></tr>}@foreach(var item in Model.Items){<tr><td><strong>@item.Title</strong></td><td><span class="type-chip">@item.Type</span></td><td>@item.Publisher</td><td>@item.PublishedDate.ToString("dd MMM yyyy")</td><td>@if(item.IsAvailable){<span class="availability available">Available</span>}else{<span class="availability borrowed">Checked Out</span>}</td><td><div class="action-group">@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a><form asp-action="ToggleAvailability" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-dark">Toggle</button></form><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>}</div></td></tr>}</tbody></table></div>@if(Model.TotalPages>1){<nav class="hub-pagination"><a class="@(Model.HasPreviousPage?"":"disabled")" asp-route-type="@Model.Type" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage-1)">Previous</a>@for(int i=1;i<=Model.TotalPages;i++){<a class="@(i==Model.CurrentPage?"active":"")" asp-route-type="@Model.Type" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@i">@i</a>}<a class="@(Model.HasNextPage?"":"disabled")" asp-route-type="@Model.Type" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage+1)">Next</a></nav>}</section>
