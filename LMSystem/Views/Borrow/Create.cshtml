@model BorrowViewModel
@{ ViewData["Title"]="Borrow Book"; }
<div class="form-shell"><div class="form-card"><div class="form-header green"><i class="bi bi-journal-arrow-up"></i><div><span>ISSUE TRANSACTION</span><h1>Borrow Book</h1><p>@Model.BookTitle</p></div></div><form asp-action="Create" method="post" class="form-body"><input type="hidden" asp-for="BookId"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="BorrowerName"></label><input asp-for="BorrowerName" class="form-control"/><span asp-validation-for="BorrowerName"></span></div><div class="row g-3"><div class="col-md-6"><label asp-for="BorrowerEmail"></label><input asp-for="BorrowerEmail" class="form-control"/><span asp-validation-for="BorrowerEmail"></span></div><div class="col-md-6"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone"></span></div></div><div class="info-note"><i class="bi bi-calendar-check"></i><span>The standard loan period is 14 days.</span></div><div class="form-actions"><a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-dark">Confirm Borrow</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
