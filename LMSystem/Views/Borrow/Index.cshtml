@model PagedResult<BorrowRecord>
@{ ViewData["Title"]="Patron Records"; }
<div class="page-title-row"><div><span class="eyebrow">TRANSACTION TRACKING</span><h1>Patron Records</h1><p>Monitor active loans, returns, overdue status and extensions.</p></div><a asp-controller="Books" asp-action="Index" class="btn btn-dark"><i class="bi bi-book me-1"></i>Open Catalog</a></div><section class="content-panel"><div class="list-toolbar"><form method="get" class="search-box"><i class="bi bi-search"></i><input name="searchTerm" value="@Model.SearchTerm" placeholder="Search borrower, email or book"/><button>Search</button>@if(!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index">Clear</a>}</form><span class="record-count">@Model.TotalItems transactions</span></div><div class="table-responsive"><table class="table hub-table mb-0"><thead><tr><th>Book</th><th>Borrower</th><th>Borrowed</th><th>Due Date</th><th>Status</th><th>Fine</th><th>Actions</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-row">No borrow records found.</td></tr>}@foreach(var item in Model.Items){<tr><td><strong>@item.Book?.Title</strong><small>@item.Book?.ISBN</small></td><td><strong>@item.BorrowerName</strong><small>@item.BorrowerEmail</small></td><td>@item.BorrowDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@item.DueDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@if(item.ReturnDate is not null){<span class="availability available">Returned</span>}else if(item.IsOverdue){<span class="availability overdue">Overdue</span>}else{<span class="availability borrowed">Active</span>}</td><td>@item.EstimatedFine.ToString("C")</td><td><div class="action-group">@if(item.ReturnDate is null){<a asp-action="Return" asp-route-borrowRecordId="@item.BorrowRecordId" class="btn btn-sm btn-success">Return</a><form asp-action="Extend" asp-route-id="@item.BorrowRecordId" method="post"><button class="btn btn-sm btn-outline-dark">Extend 7d</button></form>}</div></td></tr>}</tbody></table></div>@if(Model.TotalPages>1){<nav class="hub-pagination"><a class="@(Model.HasPreviousPage?"":"disabled")" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage-1)">Previous</a>@for(int i=1;i<=Model.TotalPages;i++){<a class="@(i==Model.CurrentPage?"active":"")" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@i">@i</a>}<a class="@(Model.HasNextPage?"":"disabled")" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage+1)">Next</a></nav>}</section>
