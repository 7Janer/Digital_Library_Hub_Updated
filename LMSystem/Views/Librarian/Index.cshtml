@model PagedResult<LibrarianModel>
@{ ViewData["Title"]="Librarians"; }
<div class="page-title-row"><div><span class="eyebrow">STAFF MANAGEMENT</span><h1>Librarians</h1><p>Manage authorized library staff and contact records.</p></div><a asp-action="Create" class="btn btn-dark"><i class="bi bi-person-plus me-1"></i>Add Librarian</a></div><section class="content-panel"><div class="list-toolbar"><form method="get" class="search-box"><i class="bi bi-search"></i><input name="searchTerm" value="@Model.SearchTerm" placeholder="Search name or phone"/><button>Search</button>@if(!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index">Clear</a>}</form><span class="record-count">@Model.TotalItems records</span></div><div class="table-responsive"><table class="table hub-table mb-0"><thead><tr><th>ID</th><th>Name</th><th>Age</th><th>Phone</th><th>Actions</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="5" class="empty-row">No librarian records found.</td></tr>}@foreach(var item in Model.Items){<tr><td>#@item.LibrarianId</td><td><strong>@item.Name</strong></td><td>@item.Age</td><td>@item.Phone</td><td><div class="action-group"><a asp-action="Edit" asp-route-id="@item.LibrarianId" class="btn btn-sm btn-outline-secondary">Edit</a><form asp-action="Delete" asp-route-id="@item.LibrarianId" method="post" onsubmit="return confirm('Delete this librarian?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>}</tbody></table></div>@if(Model.TotalPages>1){<nav class="hub-pagination"><a class="@(Model.HasPreviousPage?"":"disabled")" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage-1)">Previous</a>@for(int i=1;i<=Model.TotalPages;i++){<a class="@(i==Model.CurrentPage?"active":"")" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@i">@i</a>}<a class="@(Model.HasNextPage?"":"disabled")" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage+1)">Next</a></nav>}</section>
