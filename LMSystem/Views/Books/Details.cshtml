@model Book
@{ ViewData["Title"]="Book Details"; }
<div class="detail-shell"><div class="detail-cover"><i class="bi bi-book-half"></i><span>@Model.Category</span></div><section class="detail-card"><div class="detail-header"><span>BOOK DETAILS</span><h1>@Model.Title</h1><p>@Model.Author</p></div><dl class="detail-grid"><div><dt>ISBN</dt><dd>@Model.ISBN</dd></div><div><dt>Publisher</dt><dd>@Model.Publisher</dd></div><div><dt>Published Date</dt><dd>@Model.PublishedDate.ToString("dd MMMM yyyy")</dd></div><div><dt>Availability</dt><dd>@if(Model.IsAvailable){<span class="availability available">Available</span>}else{<span class="availability borrowed">Checked Out</span>}</dd></div></dl><div class="form-actions justify-content-start"><a asp-action="Index" class="btn btn-outline-secondary">Back to Catalog</a>@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-dark">Edit Book</a>}@if(Model.IsAvailable){<a asp-controller="Borrow" asp-action="Create" asp-route-bookId="@Model.BookId" class="btn btn-success">Borrow Book</a>}</div></section></div>
