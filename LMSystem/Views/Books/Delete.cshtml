@model Book
@{ ViewData["Title"]="Delete Book"; }
<div class="form-shell"><div class="form-card danger-card"><div class="form-header danger"><i class="bi bi-exclamation-triangle"></i><div><span>DESTRUCTIVE ACTION</span><h1>Confirm Delete</h1></div></div><div class="form-body"><div class="delete-warning"><strong>Delete “@Model.Title”?</strong><p>This action removes the book and its related borrowing history permanently.</p></div><dl class="detail-grid compact"><div><dt>Author</dt><dd>@Model.Author</dd></div><div><dt>ISBN</dt><dd>@Model.ISBN</dd></div></dl><form asp-action="Delete" method="post" class="form-actions"><input type="hidden" asp-for="BookId"/><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-danger" type="submit">Delete Book</button></form></div></div></div>
