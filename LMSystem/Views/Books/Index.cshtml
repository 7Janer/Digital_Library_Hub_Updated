@model PagedResult<Book>
@{ ViewData["Title"] = "Book Catalog"; }
<div class="page-title-row"><div><span class="eyebrow">COLLECTION CONTROL</span><h1>Book Catalog</h1><p>Search, review and manage the complete book inventory.</p></div>@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus-lg me-1"></i>Add New Book</a>}</div>
<section class="content-panel">
    <div class="list-toolbar">
        <form asp-action="Index" method="get" class="search-box"><i class="bi bi-search"></i><input name="searchTerm" value="@Model.SearchTerm" placeholder="Search title, author, ISBN, publisher or category" /><button type="submit">Search</button>@if(!string.IsNullOrWhiteSpace(Model.SearchTerm)){<a asp-action="Index">Clear</a>}</form>
        <span class="record-count">@Model.TotalItems records</span>
    </div>
    <div class="table-responsive"><table class="table hub-table mb-0"><thead><tr><th>Title</th><th>Author</th><th>ISBN</th><th>Category</th><th>Published</th><th>Availability</th><th>Actions</th></tr></thead><tbody>
    @if(Model.Items.Count == 0){<tr><td colspan="7" class="empty-row">No books match your search.</td></tr>}
    @foreach(var book in Model.Items){<tr><td><strong>@book.Title</strong><small>@book.Publisher</small></td><td>@book.Author</td><td>@book.ISBN</td><td>@book.Category</td><td>@book.PublishedDate.ToString("dd MMM yyyy")</td><td>@if(book.IsAvailable){<span class="availability available">Available</span>}else{<span class="availability borrowed">Borrowed</span>}</td><td><div class="action-group"><a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-dark">Details</a>@if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){<a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary">Edit</a><a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">Delete</a>}@if(book.IsAvailable){<a asp-controller="Borrow" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-sm btn-dark">Borrow</a>}else if(User.IsInRole("Administrator") || User.IsInRole("Librarian")){var active=book.BorrowRecords.FirstOrDefault(r=>r.ReturnDate==null);if(active is not null){<a asp-controller="Borrow" asp-action="Return" asp-route-borrowRecordId="@active.BorrowRecordId" class="btn btn-sm btn-success">Return</a>}}</div></td></tr>}
    </tbody></table></div>
    @if(Model.TotalPages > 1){<nav class="hub-pagination"><a class="@(Model.HasPreviousPage ? "" : "disabled")" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage-1)">Previous</a>@for(int i=1;i<=Model.TotalPages;i++){<a class="@(i==Model.CurrentPage ? "active" : "")" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@i">@i</a>}<a class="@(Model.HasNextPage ? "" : "disabled")" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage+1)">Next</a></nav>}
</section>
