@model ContactMessage
@{ ViewData["Title"]="Contact Us"; }
<div class="contact-layout"><section class="content-panel"><div class="panel-heading"><div><span>SUPPORT DESK</span><h1>Contact Us</h1><p>Report broken links, missing inventory or account issues.</p></div></div><form asp-action="Index" method="post" class="form-body p-0"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="Enter your full name"/><span asp-validation-for="Name"></span></div><div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="Enter your email"/><span asp-validation-for="Email"></span></div><div class="mb-3"><label asp-for="Message"></label><textarea asp-for="Message" rows="6" class="form-control" placeholder="Describe how we can help"></textarea><span asp-validation-for="Message"></span></div><button class="btn btn-dark">Submit Ticket</button></form></section><aside class="support-card"><i class="bi bi-headset"></i><h2>Support Desk</h2><p>Our administration team reviews submitted tickets from the Member Admin area.</p><hr/><strong>Email</strong><span>support@digitallibraryhub.local</span><strong>Hours</strong><span>Monday to Friday, 9:00 AM to 6:00 PM</span></aside></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
