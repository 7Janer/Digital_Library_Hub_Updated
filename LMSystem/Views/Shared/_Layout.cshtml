@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Library Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<header class="hub-header">
    <nav class="navbar navbar-expand-xl navbar-light py-2">
        <div class="container-fluid hub-shell">
            <a class="navbar-brand hub-brand" asp-controller="Home" asp-action="Index">
                <span class="hub-logo" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>Digital Library Hub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hubNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="hubNav">
                <ul class="navbar-nav ms-auto align-items-xl-center hub-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Book Catalog</a></li>
                        @if (User.IsInRole("Administrator") || User.IsInRole("Librarian"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Borrow" asp-action="Index">Patron Records</a></li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Periodicals</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Publications" asp-action="Index" asp-route-type="Newspaper"><i class="bi bi-newspaper me-2"></i>Newspapers</a></li>
                                <li><a class="dropdown-item" asp-controller="Publications" asp-action="Index" asp-route-type="Magazine"><i class="bi bi-journals me-2"></i>Magazines</a></li>
                            </ul>
                        </li>
                        @if (User.IsInRole("Administrator") || User.IsInRole("Librarian"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Index">Students</a></li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Member Admin</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Librarian" asp-action="Index">Librarians</a></li>
                                    <li><a class="dropdown-item" asp-controller="UserAdmin" asp-action="Index">Users & Roles</a></li>
                                    <li><a class="dropdown-item" asp-controller="ContactUs" asp-action="Tickets">Support Tickets</a></li>
                                </ul>
                            </li>
                        }
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="AboutUs" asp-action="Index">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ContactUs" asp-action="Index">Contact</a></li>
                </ul>
                <div class="hub-auth ms-xl-3 mt-3 mt-xl-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn user-chip dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i><span>@(User.Identity.Name)</span></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger" type="submit">Sign Out</button></form></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-dark me-2" asp-controller="Account" asp-action="Login">Sign In</a>
                        <a class="btn btn-sm btn-dark" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="flex-grow-1 hub-main">
    <div class="container-fluid hub-shell py-4">
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show hub-alert" role="alert"><i class="bi bi-check-circle-fill me-2"></i>@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show hub-alert" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </div>
</main>

<footer class="hub-footer mt-auto">
    <div class="container-fluid hub-shell d-flex flex-column flex-md-row justify-content-between gap-2">
        <span>&copy; @DateTime.Now.Year - Digital Library Hub - All Rights Reserved</span>
        <span>Digital Library Management System</span>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
