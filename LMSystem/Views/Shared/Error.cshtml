@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h1 class="mt-3">Something went wrong</h1>
    <p class="text-muted">The application could not complete your request.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
</div>
